# ==========================================
# MongoDB Atlas Database Configuration Template
# ==========================================
# 1. Create a free cluster on MongoDB Atlas (https://www.mongodb.com/atlas)
# 2. In Atlas, click 'Connect' -> 'Drivers' (Python)
# 3. Copy your connection string and paste below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=biometric_fingerprint_db
COLLECTION_NAME=users

# Application Settings
PORT=5000
DEBUG=True
SECRET_KEY=biometric_super_secure_key_998822
MATCH_THRESHOLD=0.65
